# Copy to .env.local (gitignored) and fill in your own values.
#
# NEVER prefix any of these with NEXT_PUBLIC_. That prefix inlines the value
# into the JavaScript bundle sent to every visitor — see docs/backend.md §5.

# The application database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/azuki

# A separate database for the integration test suite. It is TRUNCATEd between
# tests, so it must never point at the one above.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/azuki_test
